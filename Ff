-- VOAR (estilo Miranda)
local voando = false
local cancelarVoo = false

local function voarPara(destino, velocidade)
    if voando then return end
    voando = true
    cancelarVoo = false
    local ch = pl.Character
    if not ch then voando = false return end
    local h = ch:FindFirstChild("HumanoidRootPart")
    local hum = ch:FindFirstChild("Humanoid")
    if not h or not hum then voando = false return end
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
    local inicio = h.CFrame
    local alvo = CFrame.new(destino.Position + Vector3.new(0, 12, 0))
    local distancia = (inicio.Position - alvo.Position).Magnitude
    local tempo = math.max(distancia / velocidade, 0.3)
    local t = 0
    local conn
    conn = RS.Heartbeat:Connect(function(dt)
        if cancelarVoo then
            conn:Disconnect()
            voando = false
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            return
        end
        t = t + dt
        local pct = math.min(t / tempo, 1)
        h.CFrame = inicio:Lerp(alvo, pct)
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
        if pct >= 1 then
            conn:Disconnect()
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            voando = false
        end
    end)
end

-- SEGURAR NO PET
local function segurarNoPet(petPart)
    if not petPart then return end
    local pos, naTela = cam:WorldToViewportPoint(petPart.Position)
    if not naTela then return end
    pcall(function()
        VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
    end)
    task.wait(2)
    pcall(function()
        VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
    end)
end

-- IR PEGAR E VOLTAR
local function irPegarVoltar()
    if not cfg.pet or not cfg.pet.parte then return end
    local ch = pl.Character
    if not ch then return end
    local h = ch:FindFirstChild("HumanoidRootPart")
    if not h then return end
    cfg.base = cfg.base or h.CFrame
    voarPara(cfg.pet.parte, cfg.vT)
    while voando do task.wait(0.1) end
    task.wait(0.3)
    segurarNoPet(cfg.pet.parte)
    task.wait(0.5)
    if cfg.base then
        voarPara(cfg.base, cfg.vT * 1.5)
        while voando do task.wait(0.1) end
    end
end


local function pegarValor(o)
    local v = o:GetAttribute("Value") or o:GetAttribute("Earnings") or o:GetAttribute("Renda") or o:GetAttribute("Money") or o:GetAttribute("Income") or 0
    local fv = o:FindFirstChild("Value") or o:FindFirstChild("Earnings") or o:FindFirstChild("Renda") or o:FindFirstChild("Income")
    if fv and fv:IsA("ValueBase") then v = fv.Value end
    return tonumber(v) or 0
end

local function escanear()
    petsMapa = {}
    for _, o in ipairs(workspace:GetDescendants()) do
        if o:IsA("Model") and o.Parent then
            local pt = o:FindFirstChild("HumanoidRootPart") or o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart")
            if pt then
                local v = pegarValor(o)
                local nl = o.Name:lower()
                local ePet = nl:find("egg") or nl:find("ovo") or nl:find("brainrot") or nl:find("pet") or nl:find("gorilla") or nl:find("gorila") or nl:find("dragon") or nl:find("demon") or nl:find("eternal")
                if ePet or v > 0 then
                    table.insert(petsMapa, {nome=o.Name, valor=v, parte=pt, obj=o})
                end
            end
        end
    end
    table.sort(petsMapa, function(a,b) return a.valor > b.valor end)
end

local function icone(obj)
    local img = ""
    local dec = obj:FindFirstChildWhichIsA("Decal", true)
    if dec then img = dec.Texture end
    if img == "" then
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("Decal") or d:IsA("Texture") then
                img = d.Texture
                break
            end
        end
    end
    return img
end

